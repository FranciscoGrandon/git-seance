# ===============================================================================
# GitSéance .gitignore
# Creado por Francisco Grandón Vergara
# ===============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Testing, linting and coverage caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local workspace scratchpad & backups
scratch/
_backups/

# Internal process & planning documents
auditoria_*.md
plan_*.md
*evaluacion*.md
*evaluación*.md
devto_post_*.md
